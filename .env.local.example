# Supabase project URL (found in Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (found in Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (found in Supabase Dashboard > Settings > API)
# Used server-side only for webhook handlers that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe secret key (found in Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_your-key-here

# Stripe webhook signing secret (found in Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Stripe price ID for monthly membership
STRIPE_MONTHLY_PRICE_ID=price_your-price-id-here
